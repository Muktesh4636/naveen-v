# Copy this file to .env and fill in real values before deploying.

SECRET_KEY=change-me-to-a-long-random-string

DEBUG=true

# Comma-separated list of allowed hostnames. Use * for local dev only.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection
DB_NAME=visaslots
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Telegram alerts (Bot API) — only sends when contribution has available dates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_MUKTESH_CHAT_ID=
TELEGRAM_DEDUP_SECONDS=300

# Extension API HMAC — blocks unsigned curl/Postman on /contribute*
EXTENSION_API_KEY=vs1
EXTENSION_API_SECRET=change-me-long-random-hex
EXTENSION_API_SKEW_SEC=300
# EXTENSION_API_AUTH_DISABLED=1  # emergency only
